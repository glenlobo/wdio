{
    "printWidth": 120,
    "tabWidth": 2,
    "trailingComma": "all",
    "singleQuote": true,
    "semi": true,
    "bracketSpacing": false,
    "endOfLine": "auto",
    "importOrder": [
        "^@data/(.*)$",
        "^@pages(.*)$",
        "^@test/(.*)$",
        "^@wdio/(.*)$",
        "^[./]",
        "<THIRD_PARTY_MODULES>"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrderImportAttributesKeyword": "with",
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "printWidth": 1,
                "tabWidth": 2,
                "semi": true,
                "singleQuote": false,
                "trailingComma": "none",
                "bracketSpacing": true,
                "arrayBracketNewline": true,
                "arrayElementNewline": true
            }
        }
    ],
    "plugins": [
        "@trivago/prettier-plugin-sort-imports"
    ]
}
